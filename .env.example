DATABASE_URL=database_url

CASSANDRA_HOST=host
CASSANDRA_DATACENTER=datacenter
CASSANDRA_KEYSPACE=keyspace

REDIS_HOST=host
REDIS_PORT=port

PORT=port

NODE_ENV=node_env
JWT_ACCESS_SECRET=jwt_access_secret
JWT_REFRESH_SECRET=jwt_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=access_token_expires_in
REFRESH_TOKEN_EXPIRES_IN=refresh_token_expires_in

COOKIE_DOMAIN=cookie_domain
FRONTEND_ORIGIN=frontend_origin
# Extra allowed browser origins, comma-separated (www/staging domains, Vite dev, Expo web on :8081).
# Mobile apps need no entry. Do not use * or null.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

FROM_EMAIL=from_email
RESEND_API_KEY=resend_api_key

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=chat-media
MINIO_PRESIGNED_EXPIRY_SECONDS=60
# Host that clients (browsers, phones) use to download media. Presigned links are
# signed for this host. Dev with phones: your PC LAN IP. Prod: the public media host.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=
MINIO_PUBLIC_USE_SSL=

# File Upload Size Limits (in bytes)
# Default max for general uploads (25 MB)
MEDIA_MAX_UPLOAD_BYTES=26214400
# Images (10 MB)
MEDIA_IMAGE_MAX_UPLOAD_BYTES=10485760
# Audio files (20 MB)
MEDIA_AUDIO_MAX_UPLOAD_BYTES=20971520
# Video files (100 MB)
MEDIA_VIDEO_MAX_UPLOAD_BYTES=104857600
# Documents (25 MB)
MEDIA_DOC_MAX_UPLOAD_BYTES=26214400
# Avatar/Profile pictures (5 MB)
AVATAR_MAX_UPLOAD_BYTES=5242880

# Upload Rate Limiting
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# Push Notifications (Web Push VAPID keys)
# Generate keys using: node generate-vapid-keys.js
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com
PUSH_NOTIFICATION_ASSETS_BASE_URL=/assets
PUSH_NOTIFICATION_ICON_PATH=/assets/notification-icon.svg
PUSH_NOTIFICATION_BADGE_PATH=/assets/notification-badge.svg

# LiveKit server (locally running server default)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# docker-compose's LiveKit reads the same key/secret. The secret must be 32+ characters.
# Optional: address browsers/apps use if it differs from LIVEKIT_URL (e.g. wss://livekit.example.com).
LIVEKIT_PUBLIC_URL=
# docker-compose only: IP that clients send media to (127.0.0.1 for this PC, LAN IP for phones),
# and the interface LiveKit listens on (127.0.0.1 = this PC only; 0.0.0.0 = your network, for phones).
LIVEKIT_NODE_IP=
LIVEKIT_BIND_IP=
